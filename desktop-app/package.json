{
  "name": "ahh-hamilton",
  "version": "3.0.0",
  "description": "Association Haïtienne de Hamilton — Application de bureau",
  "main": "main.js",
  "author": "AHH",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build-portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "ca.ahhamilton.desktop",
    "productName": "AHH Hamilton",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "shortcutName": "AHH Hamilton"
    },
    "portable": {
      "artifactName": "AHH-Hamilton-Portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^25.1.8"
  }
}
