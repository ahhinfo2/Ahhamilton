{
  "expo": {
    "name": "AHH Hamilton",
    "slug": "ahh-hamilton",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b5e20"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.ahhamilton.app",
      "infoPlist": {
        "NSCameraUsageDescription": "L'app utilise la caméra pour scanner les QR codes des billets et cartes membres."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1b5e20"
      },
      "package": "ca.ahhamilton.app",
      "permissions": ["CAMERA", "VIBRATE", "RECEIVE_BOOT_COMPLETED"]
    },
    "plugins": [
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1b5e20"
        }
      ]
    ],
    "extra": {
      "eas": { "projectId": "" }
    }
  }
}
